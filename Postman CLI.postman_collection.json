    {
      "name": "Get the list of users",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const randomNumber = Math.floor(Math.random() * 20);\r",
              "pm.environment.set(\"randomNumber\", randomNumber);\r",
              "console.log(\"Random Number:\", randomNumber);\r",
              "\r",
              "const responseJson = pm.response.json();\r",
              "\r",
              "const Randomid = responseJson[randomNumber].id;\r",
              "pm.environment.set(\"Randomid\", Randomid);\r",
              "console.log(\"Random ID selected: \" + Randomid);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://gorest.co.in/public/v2/users",
          "protocol": "https",
          "host": [
            "gorest",
