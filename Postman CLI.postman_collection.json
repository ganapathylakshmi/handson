    {
      "name": "Create a new User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const responseJson = pm.response.json();",
              "pm.test(\"To get the ID\", function () {",
              "",
              "    const id = responseJson.id;",
              "",
              "    pm.globals.set(\"response ID \", id);",
              "    console.log(\"ID is : \" + id);",
              "}",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "//to generate random Email\r",
              "const randomName = \"user\" + Math.floor(Math.random() * 1000);\r",
              "const randomEmail = `${randomName}@test.com`;\r",
              "\r",
              "pm.environment.set(\"randomName\", randomName);\r",
              "pm.environment.set(\"randomEmail\", randomEmail);\r",
              "\r",
              "console.log(\"Random Name:\", randomName);\r",
              "console.log(\"Random Email:\", randomEmail);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
